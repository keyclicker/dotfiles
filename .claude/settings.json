{
  "permissions": {
    "allow": [
      "mcp__plugin_context7_context7__query-docs",
      "mcp__next-devtools__nextjs_docs",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_navigate",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:mcp-proxy.anthropic.com)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear)"
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.dotfiles/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "clangd-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "github@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "code.claude.com",
        "docs.claude.com"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.aws",
        "~/.ssh",
        "~/.gnupg",
        "~/.config/gcloud",
        "~/Downloads",
        "~/Documents",
        "~/Desktop",
        "~/Applications",
        "~/Movies",
        "~/Music",
        "~/Pictures",
        "~/.Trash",
        "~/Root"
      ],
      "allowRead": [
        "~/.config",
        "~/.claude",
        "~/.dotfiles",
        "~/Root/Programming/"
      ]
    },
    "excludedCommands": [
      "docker logs *",
      "docker compose logs *",
      "docker-compose logs *"
    ]
  },
  "effortLevel": "xhigh",
  "theme": "auto",
  "editorMode": "vim"
}
