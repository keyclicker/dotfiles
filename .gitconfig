[user]
	email = nick@keyclicker.dev
	name = keyclicker
	signingkey = 577CB135713C717B

[commit]
	gpgsign = true

[core]
	editor = nvim
    ; pager = delta

[worktree]
	useRelativePaths = true

[init]
	defaultBranch = master

; Machine-local settings (credential helpers, etc.) live outside the
; repo. Last include wins on key conflicts.
[include]
	path = ~/.gitconfig.local

; [interactive]
;     diffFilter = delta --color-only
;
; [delta]
;     navigate = true  # use n and N to move between diff sections
;     dark = true      # or light = true, or omit for auto-detection
; 	line-numbers = true
;
; [merge]
;     conflictStyle = zdiff3
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
