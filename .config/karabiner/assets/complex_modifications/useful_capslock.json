{
  "title": "Useful CapsLock",
  "rules": [
    {
      "description": "Useful CapsLock",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.googlecode\\.iterm2$",
                "^com\\.microsoft\\.VSCode$",
                "^org\\.gnu\\.Emacs$",
                "^org\\.alacritty$"
              ],
              "type": "frontmost_application_unless"
            }
          ],
          "from": {
            "key_code": "caps_lock"
          },
          "to": [
            {
              "apple_vendor_top_case_key_code": "keyboard_fn"
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.googlecode\\.iterm2$",
                "^com\\.microsoft\\.VSCode$",
                "^org\\.gnu\\.Emacs$",
                "^org\\.alacritty$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "caps_lock"
          },
          "to": [
            {
              "key_code": "escape"
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
