{
  "title": "My very own custom mappings.",
  "rules": [
    {
      "description": "My very own custom mappings.",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_control" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_control",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_option" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_option",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "vk_none" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "tab" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_option",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "caps_lock" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "tab",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "escape" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "escape",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "fn" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "fn",
            "modifiers": { "optional": ["any"] }
          },
          "to": {
            "key_code": "left_command",
            "modifiers": ["left_control", "left_option"]
          }
        }
      ]
    }
  ]
}
