# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term ghostty
# Your preferred application launcher
set $menu wofi --show drun
# Bindings by keycode, so they survive a switch to ua or ru
set $bind bindsym --to-code

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output * bg ~/Wallpapers/wallpaper.png fill

# output eDP-1 scale 1.25

#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
#
# Example configuration:

exec swayidle -w \
         timeout 300 'swaylock -f -c 000000' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep 'swaylock -f -c 000000'

# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

$bind $mod+Shift+p exec 'swaylock -f -c 000000'

### Input configuration
#
# Example configuration:
#
    input type:touchpad {
        # dwt enabled
        # tap enabled
        natural_scroll enabled
        scroll_factor 0.2
        # middle_emulation enabled
    }

    input type:pointer {
    }

    input type:keyboard {
        xkb_layout us,ua,ru
        xkb_options grp:alt_shift_toggle
    }

    $bind $mod+u input type:keyboard xkb_switch_layout 0
    $bind $mod+i input type:keyboard xkb_switch_layout 1
    $bind $mod+o input type:keyboard xkb_switch_layout 2

#
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.

### Key bindings
#
# Basics:
#
    # Start a terminal
    $bind $mod+Return exec $term

    # Kill focused window
    $bind $mod+q kill

    # Start your launcher
    $bind $mod+d exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    $bind $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    $bind $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    $bind $mod+$left focus left
    $bind $mod+$down focus down
    $bind $mod+$up focus up
    $bind $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    $bind $mod+Left focus left
    $bind $mod+Down focus down
    $bind $mod+Up focus up
    $bind $mod+Right focus right

    # Move the focused window with the same, but add Shift
    $bind $mod+Shift+$left move left
    $bind $mod+Shift+$down move down
    $bind $mod+Shift+$up move up
    $bind $mod+Shift+$right move right
    # Ditto, with arrow keys
    $bind $mod+Shift+Left move left
    $bind $mod+Shift+Down move down
    $bind $mod+Shift+Up move up
    $bind $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    $bind $mod+1 workspace number 1
    $bind $mod+2 workspace number 2
    $bind $mod+3 workspace number 3
    $bind $mod+4 workspace number 4
    $bind $mod+5 workspace number 5
    $bind $mod+6 workspace number 6
    $bind $mod+7 workspace number 7
    $bind $mod+8 workspace number 8
    $bind $mod+9 workspace number 9
    $bind $mod+0 workspace number 10
    # Move focused container to workspace
    $bind $mod+Shift+1 move container to workspace number 1
    $bind $mod+Shift+2 move container to workspace number 2
    $bind $mod+Shift+3 move container to workspace number 3
    $bind $mod+Shift+4 move container to workspace number 4
    $bind $mod+Shift+5 move container to workspace number 5
    $bind $mod+Shift+6 move container to workspace number 6
    $bind $mod+Shift+7 move container to workspace number 7
    $bind $mod+Shift+8 move container to workspace number 8
    $bind $mod+Shift+9 move container to workspace number 9
    $bind $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    $bind $mod+b splith
    $bind $mod+v splitv

    # Switch the current container between different layout styles
    $bind $mod+s layout stacking
    $bind $mod+w layout tabbed
    $bind $mod+e layout toggle split

    # Make the current focus fullscreen
    $bind $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    $bind $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    $bind $mod+space focus mode_toggle

    # Move focus to the parent container
    $bind $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    $bind $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    $bind $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    $bind $left resize shrink width 10px
    $bind $down resize grow height 10px
    $bind $up resize shrink height 10px
    $bind $right resize grow width 10px

    # Ditto, with arrow keys
    $bind Left resize shrink width 10px
    $bind Down resize grow height 10px
    $bind Up resize shrink height 10px
    $bind Right resize grow width 10px

    # Return to default mode
    $bind Return mode "default"
    $bind Escape mode "default"
}
$bind $mod+r mode "resize"
#
# Utilities:
#
    # Special keys to adjust volume via PulseAudio
    $bind --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
    $bind --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
    $bind --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
    $bind --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

    # Special keys to control media via playerctl
    $bind --locked XF86AudioPlay exec playerctl play-pause
    $bind --locked XF86AudioPause exec playerctl play-pause
    $bind --locked XF86AudioPrev exec playerctl previous
    $bind --locked XF86AudioNext exec playerctl next
    $bind --locked XF86AudioStop exec playerctl stop

    # Special keys to adjust brightness via brightnessctl
    $bind --locked XF86MonBrightnessDown exec brightnessctl set 5%-
    $bind --locked XF86MonBrightnessUp exec brightnessctl set 5%+

    # Special key to take a screenshot with grim
    # $bind Print exec grim

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
bar {
    swaybar_command waybar
}

gaps inner 5
default_border pixel 2

font pango:JetBrains Mono 14


include /etc/sway/config.d/*
