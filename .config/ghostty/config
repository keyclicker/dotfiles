font-family = JetBrainsMono
font-feature = -calt

theme = light:TokyoNight Day,dark:TokyoNight Moon

window-colorspace = srgb
macos-option-as-alt = true

# Tabs live in the titlebar: one row instead of titlebar + tab bar.
# Retry alone: it broke tabs before together with the keys below.
# Default (`transparent`) is the fallback if tabs vanish again.
macos-titlebar-style = tabs

# window-decoration = auto
# macos-window-shadow = false
# keybind = super+e=toggle_window_decorations

window-padding-balance = true
window-padding-x = 4
window-padding-y = 0

cursor-style = bar
cursor-style-blink = false
# ssh-terminfo: auto-install xterm-ghostty terminfo on remote hosts;
# ssh-env: fall back to TERM=xterm-256color + COLORTERM where it can't
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
adjust-cursor-thickness = 2
cursor-invert-fg-bg = false
cursor-text = #0b0d0b

quick-terminal-position = center
quick-terminal-size = 600px,400px
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0
keybind = global:alt+space=toggle_quick_terminal

# Per-OS look: home-manager links `platform` to `macos` or `linux`.
# Includes load after CLI flags, so their keys beat launcher flags.
config-file = ?platform

# Machine-local overrides, not in the dotfiles: ~/.config/ghostty/local
config-file = ?local
