# Included as `platform` on Linux (see the end of `config`)

# 1pt = 1.33px here (96 dpi base): 10.5pt matches the mac's 14px
font-size = 10.5

# See-through like the mac. Blur works only on KDE; Xfce and most
# other compositors ignore it and show plain transparency
background-opacity = 0.75
background-blur = 20

# Tabs in the header bar, painted in the terminal's colors instead of
# libadwaita's white
gtk-titlebar-style = tabs
# Wide tabs fill the bar, leaving nothing to drag the window by
gtk-wide-tabs = false
window-theme = ghostty

# Always dark here: Xfce has no dark/light switch for the pair in
# `config` to follow, and the GTK chrome takes the terminal's colors
theme = TokyoNight Moon

# Ubuntu's launchers pass `--shell-integration-features=ssh-env`,
# which resets the other flags to defaults. Restate ours.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
