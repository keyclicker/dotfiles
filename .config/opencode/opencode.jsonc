{
  "$schema": "https://opencode.ai/config.json",

  "share": "disabled",

  "enabled_providers": ["ollama"],
  "model": "ollama/gemma4:e4b",
  "small_model": "ollama/gemma4:e2b",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "whitelist": ["gemma4:e2b", "gemma4:e4b"],
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "gemma4:e2b": {
          "name": "Gemma 4 E2B"
        },
        "gemma4:e4b": {
          "name": "Gemma 4 E4B"
        }
      }
    }
  },

  "experimental": {
    "policies": [
      {
        "effect": "deny",
        "action": "provider.use",
        "resource": "*"
      },
      {
        "effect": "allow",
        "action": "provider.use",
        "resource": "ollama"
      }
    ]
  },

  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "~/.aws/**": "ask",
      "~/.config/gcloud/**": "ask",
      "~/.gnupg/**": "ask",
      "~/.kube/**": "ask",
      "~/.local/share/opencode/auth.json": "ask",
      "~/.ssh/**": "ask"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow"
  }
}
