; Global installs land under ~/.local: bins in ~/.local/bin, which
; .zshrc has on PATH, libraries in ~/.local/lib/node_modules. Same
; place whichever node is on the box (nix profile, homebrew, nixpkgs
; via home-manager), so installers never fall back to a prefix of
; their own (~/.npm-global) that no shell looks in.
prefix=${HOME}/.local
