#!/usr/bin/env bash
#
# claude-jail — run Claude Code in an isolated Docker container.
# Only /work (the project) and a private state/pack dir are visible;
# host home, ~/.ssh, ~/.claude.json and the Keychain are not. Curated
# config is COPIED into state, never mounted, so host ~/.claude is
# untouched. Package stores persist under ~/.claude-jail/pack.
#
# Always runs --dangerously-skip-permissions: the container IS the
# sandbox, so in-container prompts are redundant. /work is read-write
# and egress is open, so only point it at projects (ideally git-tracked)
# you'd trust an autonomous agent with.
#
#   claude-jail [--rebuild] [args passed to claude...]
#
# See README.md for the mount table and threat model.
set -euo pipefail

IMAGE="claude-jail"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --rebuild forces an image rebuild; must lead. Everything else is
# passed through to claude.
FORCE_REBUILD=0
[ "${1:-}" = "--rebuild" ] && {
    FORCE_REBUILD=1
    shift
}

# ============================================================
#                           Paths
# ============================================================

# Repo root = parent of the git common dir, so all worktrees/subdirs
# share one (else just cwd).
git_root() {
    local common_dir
    if common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"; then
        dirname "$(cd "$common_dir" && pwd -P)"
    else
        pwd -P
    fi
}

# Host (your machine).
HOST_PROJECT="$(pwd -P)"    # launch dir -> /work
HOST_ROOT="$(git_root)"     # repo root; anchors memory
HOST_CONFIG="$HOME/.claude" # curated config source
HOST_MEMORY="$HOST_ROOT/.claude/memory"
HOST_TRANSCRIPTS="$HOST_ROOT/.claude/transcripts"
HOST_STATE="$HOME/.claude-jail/state" # jail's ~/.claude + login
HOST_PACK="$HOME/.claude-jail/pack"   # nix/npm/pnpm/pip/uv stores
HOST_TMP="$HOME/.claude-jail/tmp"     # persistent scratch
HOST_REQ_MARKER="$HOST_PACK/.requirements-sha"

# Container (inside the jail).
CONTAINER_WORK="/work"
CONTAINER_CONFIG="/home/agent/.claude"
CONTAINER_PROJECT="$CONTAINER_CONFIG/projects/-work"
CONTAINER_NIX="/nix"
CONTAINER_NPM="/home/agent/.npm"
CONTAINER_PNPM="/home/agent/.local/share/pnpm"
CONTAINER_PIP="/home/agent/.cache/pip"
CONTAINER_UV="/home/agent/.cache/uv"
CONTAINER_UV_DATA="/home/agent/.local/share/uv"
CONTAINER_TMP="/home/agent/tmp"

mkdir -p "$HOST_STATE" "$HOST_MEMORY" "$HOST_TRANSCRIPTS" "$HOST_TMP" \
    "$HOST_PACK/nix" "$HOST_PACK/npm" "$HOST_PACK/pnpm" \
    "$HOST_PACK/pip" "$HOST_PACK/uv-cache" "$HOST_PACK/uv-data"

# ============================================================
#                     Build & seed image
# ============================================================

# Rebuild on first use or whenever the Dockerfile / UID:GID changes.
# The signature is stored as an image label and rechecked each launch.
SIG="$(shasum -a 256 "$SCRIPT_DIR/Dockerfile" | awk '{print $1}')-$(id -u):$(id -g)"
current="$(docker image inspect -f '{{ index .Config.Labels "jail.sig" }}' \
    "$IMAGE" 2>/dev/null || true)"
if [ "$FORCE_REBUILD" = 1 ] || [ "$current" != "$SIG" ]; then
    echo "claude-jail: building image '$IMAGE'..." >&2
    docker build \
        --build-arg "UID=$(id -u)" --build-arg "GID=$(id -g)" \
        --label "jail.sig=$SIG" \
        -f "$SCRIPT_DIR/Dockerfile" -t "$IMAGE" "$SCRIPT_DIR"
fi

# The /nix bind mount overlays the image's baked store with the (empty)
# host dir, hiding it — so seed pack/nix from the image when empty.
# After a Dockerfile nix bump, rm -rf ~/.claude-jail/pack/nix to reseed.
if [ -z "$(ls -A "$HOST_PACK/nix" 2>/dev/null)" ]; then
    echo "claude-jail: seeding nix store from image..." >&2
    docker run --rm -v "$HOST_PACK/nix:/seed" "$IMAGE" sh -c 'cp -a /nix/. /seed/'
    rm -f "$HOST_REQ_MARKER" # fresh store -> re-run requirements
fi

# ============================================================
#                      Config & mounts
# ============================================================

# Jail's own settings.json — bundled with the script, NOT the host's,
# so no global config (sandbox/enabledPlugins/permissions) bleeds in.
# It already carries the in-container statusLine + pkglist SessionStart
# hook, so no --settings override is needed below.
cp -f "$SCRIPT_DIR/settings.json" "$HOST_STATE/settings.json"

# Copy curated host CONTENT (not settings) into state. cp -RL
# dereferences dotfiles symlinks; login/.credentials.json stays put.
for item in CLAUDE.md statusline.sh agents skills; do
    [ -e "$HOST_CONFIG/$item" ] || continue
    rm -rf "${HOST_STATE:?}/$item"
    cp -RL "$HOST_CONFIG/$item" "$HOST_STATE/$item" 2>/dev/null ||
        echo "claude-jail: skipped '$item' (copy failed)" >&2
done

mounts=(
    -v "$HOST_PROJECT:$CONTAINER_WORK"          # project, rw
    -v "$HOST_STATE:$CONTAINER_CONFIG"          # login + config
    -v "$HOST_TRANSCRIPTS:$CONTAINER_PROJECT"   # session .jsonl
    -v "$HOST_MEMORY:$CONTAINER_PROJECT/memory" # carved-out memory
    -v "$HOST_PACK/npm:$CONTAINER_NPM"          # npm cache
    -v "$HOST_PACK/nix:$CONTAINER_NIX"          # nix store
    -v "$HOST_PACK/pnpm:$CONTAINER_PNPM"        # pnpm store + bins
    -v "$HOST_PACK/pip:$CONTAINER_PIP"          # pip cache
    -v "$HOST_PACK/uv-cache:$CONTAINER_UV"      # uv cache
    -v "$HOST_PACK/uv-data:$CONTAINER_UV_DATA"  # uv tools + pythons
    -v "$HOST_TMP:$CONTAINER_TMP"               # persistent scratch
)

# ============================================================
#                Requirements & package list
# ============================================================

# Copy the helper scripts into state (reachable in-jail under
# ~/.claude). requirements.sh installs project tools into the pack/
# stores; run it only when it changed (installs persist, so once per
# version is enough — a nix reseed cleared the marker above to force it).
cp -f "$SCRIPT_DIR/pkglist.sh" "$HOST_STATE/pkglist.sh"
if [ -f "$SCRIPT_DIR/requirements.sh" ]; then
    cp -f "$SCRIPT_DIR/requirements.sh" "$HOST_STATE/requirements.sh"
    req_sha="$(shasum -a 256 "$SCRIPT_DIR/requirements.sh" | awk '{print $1}')"
    if [ "$FORCE_REBUILD" = 1 ] ||
        [ "$(cat "$HOST_REQ_MARKER" 2>/dev/null || true)" != "$req_sha" ]; then
        echo "claude-jail: running requirements.sh..." >&2
        if docker run --rm \
            --cap-drop ALL --security-opt no-new-privileges \
            -e "CLAUDE_CONFIG_DIR=$CONTAINER_CONFIG" \
            "${mounts[@]}" "$IMAGE" \
            bash "$CONTAINER_CONFIG/requirements.sh"; then
            printf '%s\n' "$req_sha" >"$HOST_REQ_MARKER"
        else
            echo "claude-jail: requirements.sh failed; retry next launch" >&2
        fi
    fi
fi

# ============================================================
#                            Run
# ============================================================

# Tell the jailed Claude it's sandboxed — session-only, no file.
JAIL_NOTE="$(
    cat <<'JAIL_NOTE_EOF'
You are running inside claude-jail, an isolated Docker container.

Sandbox:
- Non-root, cap-drop ALL, no-new-privileges. The container IS the sandbox.
- Only the current project is mounted, at /work (your cwd). The host home,
  ~/.ssh, ~/.claude.json and the macOS Keychain are NOT accessible.
- Network egress is open.
- Git has no host identity or SSH keys here; commits/push may need setup first.

Persists across restarts:
- ~/tmp — scratch: clone, build, cache, anything reusable.
- Login + Claude config (a separate jail state dir, not host ~/.claude).
- Package installs (below).

Installing tools — no apt (non-root), but these work and persist:
- nix  : nix profile install nixpkgs#<pkg>  (or nix run nixpkgs#<pkg>) — anything
- pnpm : pnpm add -g <pkg> — Node CLIs
- uv   : full Python toolkit — uv tool install <t> (CLI on PATH), uvx <t> (ad-hoc),
         uv venv / uv pip / uv python install <ver>

Commits — NEVER run git commit yourself. There is no GPG key in the jail, so
any commit you make would be unsigned. When the user asks you to commit, do NOT
run it; instead OUTPUT the command(s) for the user to run on the host. Always
use the -F heredoc form so the body copies clean (closing EOF at column 0):
git commit -F - <<'EOF'
<message>
EOF

Keep /work clean (it's the user's live tree — they edit and may commit it):
- Throwaway work (clones, builds, scratch) goes in ~/tmp, not /work. Don't copy
  /work into ~/tmp — it drifts from the user's live edits.
- node_modules / .venv / build in /work are the HOST's (macOS-native); building
  over them from this Linux jail corrupts them. Don't clobber host artifacts.
- Need in-tree deps? Isolate in a gitignored jail path (e.g. pnpm --modules-dir)
  and leave it — don't delete it or the user's artifacts.
Soft rule — use judgement.
JAIL_NOTE_EOF
)"

claude_args=(
    --dangerously-skip-permissions
    --append-system-prompt "$JAIL_NOTE"
)

# Non-root, dropped caps, no priv-escalation, no host access beyond
# mounts; egress open. CLAUDE_CONFIG_DIR pins .claude.json inside the
# mounted state dir, else it's lost each --rm run.
exec docker run -it --rm \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --pids-limit 512 \
    -w "$CONTAINER_WORK" \
    -e "CLAUDE_CONFIG_DIR=$CONTAINER_CONFIG" \
    -e "TERM=${TERM:-xterm-256color}" \
    -e "COLORTERM=${COLORTERM:-truecolor}" \
    -e "CLAUDE_CODE_NO_FLICKER=1" \
    -e "EDITOR=nvim" \
    -e "CAVEMAN_DEFAULT_MODE=ultra" \
    "${mounts[@]}" \
    "$IMAGE" \
    claude "${claude_args[@]}" "$@"
