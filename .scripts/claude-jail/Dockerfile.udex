# claude-jail.udex — udex-specific backend toolchain on top of the general jail.
# Built/run via `claude-jail --udex`; the base image (Dockerfile) is built first and
# referenced here by tag. Everything udex needs to run its *backend* test suite that
# the general base doesn't carry lives here, mirroring docker/back.dev.Dockerfile +
# the postgres:18 service. The base already supplies node, a Postgres server, Poetry,
# pytest and uv — this layer adds the bits unique to udex.
#
# Requirements captured in udex's docs/reference/test-environment.md:
#   - Python 3.12 (base ships 3.14, which has no wheels for udex's pinned deps)
#   - libjxl/libheif for pillow-jxl-plugin / pillow-heif (imported at app.main load)
#   - en_US.UTF-8 locale (the DB test fixture's CREATE DATABASE demands it)
#   - rustfs as a standalone S3 (no Docker socket in the jail for the compose service)
#   - udex's flake8/black/pylint lint stack
FROM claude-jail

ENV DEBIAN_FRONTEND=noninteractive

# Root for the installs; drop back to node at the end (base left us as node).
USER root

# udex apt deps (base already has postgres server, build-essential, curl).
#   libpq-dev          : pg_config + libpq headers — udex pins source-built psycopg2,
#                        so `poetry install` fails to compile it without these
#   postgresql-contrib : pg_trgm + hstore extensions (udex's postgres-init.sql)
#   nginx              : udex's dev reverse proxy (docker/nginx.dev.conf); run manually,
#                        bind a high port since cap-drop ALL blocks privileged :80
#   libjxl-dev         : JPEG-XL headers/lib — udex's pillow-jxl-plugin links them; the
#   libheif-dev        : HEIF headers/lib — pillow-heif likewise. Both import at
#                        app.main load, so every backend test needs them resolvable.
#   locales            : en_US.UTF-8 — udex's test fixture does CREATE DATABASE ...
#                        lc_ctype='en_US.UTF-8'; the base image ships only C.UTF-8, so
#                        Postgres rejects the locale until it's generated here.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpq-dev postgresql-contrib nginx \
        libjxl-dev libheif-dev locales \
    && sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*

# udex's lint stack on top of the base's ruff/mypy (flake8-pytest-style is its plugin).
RUN pip3 install --no-cache-dir --break-system-packages \
        black flake8 flake8-pytest-style pylint

# Python 3.12 for udex's backend. Ubuntu 26.04's system python3 is 3.14, which has no
# wheels for udex's pinned pydantic-core / pillow-jxl-plugin — both fall back to a PyO3
# source build that's capped at 3.13 and fails. docker/back.dev.Dockerfile uses 3.12, so
# mirror it. uv (from the base) pulls a relocatable python-build-standalone 3.12 — no
# apt PPA (deadsnakes lags new releases), no source compile. System python3.14 stays the
# default for apt/global tooling; 3.12 lives only on PATH as python3.12 so `poetry env use
# python3.12` (or poetry's PATH auto-discovery) picks it for the backend venv. Shared,
# world-readable install dir so the non-root node user can run the interpreter.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
RUN uv python install 3.12 \
    && ln -sf "$(uv python find 3.12)" /usr/local/bin/python3.12 \
    && chmod -R a+rX /opt/uv-python

# rustfs — local S3 for udex's image-upload pipeline. Not in apt (no PPA); distributed
# only as a GitHub release binary, so pulled like the base's neovim. The jail has no
# Docker socket, so the project's compose S3 (rustfs/rustfs image) can't run here — this
# is the same server as a standalone binary the non-root user can launch:
#   rustfs --access-key <key> --secret-key <key> --address :9000 ~/s3data
# Buckets ('master', 'image'): create via the :9001 console, or boto3 from the back venv.
# Pinned: releases are pre-release (beta), so /latest/download 404s — use the explicit
# tag. Asset adds a 'v' the tag omits (tag 1.0.0-beta.8 -> ...-gnu-v1.0.0-beta.8.zip).
# Glibc 'gnu' build (Ubuntu 26.04). Arch-mapped: dpkg amd64->x86_64, arm64->aarch64.
# Extracted with python3 (already on PATH) to avoid needing unzip.
ARG RUSTFS_VERSION=1.0.0-beta.8
RUN case "$(dpkg --print-architecture)" in \
        amd64) RUSTFS_ARCH=x86_64 ;; \
        arm64) RUSTFS_ARCH=aarch64 ;; \
        *) echo "unsupported arch: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/rustfs/rustfs/releases/download/${RUSTFS_VERSION}/rustfs-linux-${RUSTFS_ARCH}-gnu-v${RUSTFS_VERSION}.zip" \
        -o /tmp/rustfs.zip \
    && python3 -m zipfile -e /tmp/rustfs.zip /usr/local/bin/ \
    && chmod +x /usr/local/bin/rustfs \
    && rm /tmp/rustfs.zip

USER node
