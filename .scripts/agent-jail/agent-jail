#!/usr/bin/env bash
#
# agent-jail — run Claude Code or Codex in an isolated Docker container.
# Only the project (under /work), a private persistent home, and a
# read-only ~/.dotfiles are visible; the host home, ~/.ssh, ~/.claude.json
# and the Keychain are not. Container state persists under ~/.agent-jail.
#
# The jail's toolchain is not baked into the image: it is the flake's
# jail leaf (.nix/hosts/jail.nix), built and activated inside the
# container from the read-only ~/.dotfiles mount. One definition for the
# jail and the real machines; editing .nix reprovisions on the next launch.
#
# The container IS the sandbox, so in-container prompts are redundant.
# /work is read-write and egress is open, so only point it at projects
# (ideally git-tracked) you'd trust an autonomous agent with.
#
#   agent-jail [--claude | --codex] [--rebuild] [agent args...]
#   agent-jail paste   # clipboard image -> shared jail home, jail path copied
#
# See README.md for the mount table and threat model.
set -euo pipefail

IMAGE="agent-jail"
NIX_VOLUME="agent-jail-nix" # store; named vol, see seed block
COLIMA_PROFILE="agent-jail"
COLIMA_CPUS=4
COLIMA_MEMORY=4
COLIMA_DISK=30
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    if [[ "$SOURCE" != /* ]]; then
        SOURCE="$SOURCE_DIR/$SOURCE"
    fi
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# `agent-jail paste` — save the clipboard image (screenshot, browser "Copy
# Image") into the shared jail home and copy its in-jail path, ready to paste
# into either agent's prompt. Terminal paste is text-only, so this is the
# only route from the host clipboard into the jail.
if [ "${1:-}" = paste ]; then
    if [ "$(uname -s)" != Darwin ]; then
        echo "agent-jail: paste is macOS-only (osascript, sips, pbcopy)" >&2
        exit 1
    fi
    dir="$HOME/.agent-jail/clipboard" # visible in the jail as ~/clipboard
    file="$(date +%Y%m%d-%H%M%S).png"
    mkdir -p "$dir"
    # Apps put PNG or TIFF on the pasteboard; sips normalizes either to PNG.
    osascript \
        -e 'try' -e 'set img to the clipboard as «class PNGf»' \
        -e 'on error' -e 'set img to the clipboard as TIFF picture' -e 'end try' \
        -e "set fh to open for access POSIX file \"$dir/$file.raw\" with write permission" \
        -e 'write img to fh' -e 'close access fh' 2>/dev/null || {
        echo "agent-jail: no image on the clipboard" >&2
        exit 1
    }
    sips -s format png "$dir/$file.raw" --out "$dir/$file" >/dev/null
    rm "$dir/$file.raw"
    printf '~/clipboard/%s' "$file" | pbcopy
    echo "agent-jail: saved; jail path copied: ~/clipboard/$file"
    exit 0
fi

# Launcher flags must lead. Everything else is passed to the selected agent.
FORCE_REBUILD=0
AGENT=codex
while :; do
    case "${1:-}" in
    --rebuild)
        FORCE_REBUILD=1
        shift
        ;;
    --claude)
        AGENT=claude
        shift
        ;;
    --codex)
        AGENT=codex
        shift
        ;;
    *) break ;;
    esac
done

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "agent-jail: current directory is not inside a Git repository" >&2
    exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
    echo "agent-jail: the Docker CLI is required" >&2
    exit 1
fi

# macOS has no native containers, so keep the jail on its own Colima VM
# without changing the host's active Docker context. Linux talks to its
# own daemon: nothing to start, no context to override.
if [ "$(uname -s)" = Darwin ]; then
    if ! command -v colima >/dev/null 2>&1; then
        echo "agent-jail: Colima is required on macOS" >&2
        exit 1
    fi
    if ! colima status "$COLIMA_PROFILE" >/dev/null 2>&1; then
        echo "agent-jail: starting Colima profile '$COLIMA_PROFILE'..." >&2
        colima start "$COLIMA_PROFILE" \
            --activate=false \
            --cpus "$COLIMA_CPUS" \
            --memory "$COLIMA_MEMORY" \
            --disk "$COLIMA_DISK" \
            --vm-type vz \
            --mount-type virtiofs
    fi
    DOCKER_ARGS=(--context "colima-$COLIMA_PROFILE")
else
    DOCKER_ARGS=()
fi

# Route every Docker command in this script to the jail's daemon.
docker() {
    command docker ${DOCKER_ARGS[@]+"${DOCKER_ARGS[@]}"} "$@"
}

# ============================================================
#                           Paths
# ============================================================

# Host (your machine).
HOST_PROJECT="$(pwd -P)"      # launch dir -> /work
HOST_HOME="$HOME/.agent-jail" # jail's complete /home/keyclicker
HOST_DOTFILES="$HOME/.dotfiles"
HOST_ENV_HASH="$HOST_HOME/.env-hash"
HOST_AGENT_FLAKE="$HOST_HOME/agent-flake"
HOST_CLAUDE_HOME="$HOST_HOME/.claude"
HOST_CODEX_HOME="$HOST_HOME/.codex"

if [ ! -d "$HOST_DOTFILES/.nix" ]; then
    echo "agent-jail: no flake at $HOST_DOTFILES/.nix" >&2
    exit 1
fi

# Container (inside the jail). The project mounts at a deterministic
# per-project path so sessions, memory, and transcripts in the shared
# jail home stay separate per project.
PROJECT_NAME="$(basename "$HOST_PROJECT" | tr -cd '[:alnum:]._-')"
PROJECT_HASH="$(printf '%s' "$HOST_PROJECT" | sha256sum | cut -c1-8)"
CONTAINER_WORK="/work/$PROJECT_NAME-$PROJECT_HASH"
CONTAINER_HOME="/home/keyclicker"              # matches hosts/jail.nix
CONTAINER_DOTFILES="$CONTAINER_HOME/.dotfiles" # home/common.nix links here
CONTAINER_CLAUDE_HOME="$CONTAINER_HOME/.claude"
CONTAINER_NIX="/nix"

# The jail leaf is instantiated per architecture; the container runs the
# host's, Colima included.
case "$(uname -m)" in
arm64 | aarch64) JAIL_SYSTEM="aarch64-linux" ;;
amd64 | x86_64) JAIL_SYSTEM="x86_64-linux" ;;
*)
    echo "agent-jail: unsupported architecture $(uname -m)" >&2
    exit 1
    ;;
esac
JAIL_FLAKE="path:$CONTAINER_DOTFILES/.nix#homeConfigurations.\"keyclicker@jail-$JAIL_SYSTEM\".activationPackage"

mkdir -p "$HOST_CLAUDE_HOME" "$HOST_CODEX_HOME"

# ============================================================
#                     Build & seed image
# ============================================================

# Build on first use. After that, rebuilding is explicit via --rebuild.
if [ "$FORCE_REBUILD" = 1 ] || ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "agent-jail: building image '$IMAGE'..." >&2
    docker build \
        --build-arg "UID=$(id -u)" --build-arg "GID=$(id -g)" \
        -f "$SCRIPT_DIR/Dockerfile" -t "$IMAGE" "$SCRIPT_DIR"
fi

# A rebuild needs a fresh volume so Docker seeds it from the new image.
# That drops the store the jail environment lives in, so drop the
# profiles pointing into it too and reprovision below.
if [ "$FORCE_REBUILD" = 1 ]; then
    docker volume rm "$NIX_VOLUME" >/dev/null 2>&1 || true
    rm -f "$HOST_ENV_HASH"
    rm -f "$HOST_HOME/.nix-profile" "$HOST_HOME/.jail-activation"
    rm -rf "$HOST_HOME/.local/state/nix/profiles"
    rm -f "$HOST_HOME/.agent-tools-profile" "$HOST_HOME/.agent-tools-profile"-*-link
fi

# Seed an agent-owned flake once. Agents may edit it and update its separate,
# persistent profile without touching the read-only dotfiles.
if [ ! -d "$HOST_AGENT_FLAKE" ]; then
    cp -R "$SCRIPT_DIR/agent-flake" "$HOST_AGENT_FLAKE"
fi
docker volume inspect "$NIX_VOLUME" >/dev/null 2>&1 ||
    docker volume create "$NIX_VOLUME" >/dev/null

# ============================================================
#                      Config & mounts
# ============================================================

# Seed the jail's own settings once. Host settings are never read, and
# home/common.nix deliberately leaves these two files unmanaged, so the
# dotfiles mount cannot clobber them either.
if [ ! -f "$HOST_CLAUDE_HOME/settings.json" ]; then
    cp "$SCRIPT_DIR/config-templates/settings.json" "$HOST_CLAUDE_HOME/settings.json"
fi
if [ ! -f "$HOST_CODEX_HOME/config.toml" ]; then
    cp "$SCRIPT_DIR/config-templates/config.toml" "$HOST_CODEX_HOME/config.toml"
fi

mounts=(
    -v "$HOST_PROJECT:$CONTAINER_WORK"         # project, rw
    -v "$HOST_HOME:$CONTAINER_HOME"            # complete persistent agent home
    -v "$HOST_DOTFILES:$CONTAINER_DOTFILES:ro" # environment + instructions, ro
    -v "$NIX_VOLUME:$CONTAINER_NIX"            # case-sensitive Nix store
)

# ============================================================
#                        Provisioning
# ============================================================

# .nix is the entire build input: `path:` copies that directory alone,
# and the dotfile symlinks it declares resolve at runtime, not at build
# time. So its contents identify the environment the jail home holds.
env_hash="$(
    find "$HOST_DOTFILES/.nix" -type f -print0 |
        LC_ALL=C sort -z |
        xargs -0 cat |
        sha256sum |
        cut -d' ' -f1
)"

if [ "$(cat "$HOST_ENV_HASH" 2>/dev/null || true)" != "$env_hash" ]; then
    echo "agent-jail: building the jail environment from ~/.dotfiles..." >&2
    docker run --rm \
        --cap-drop ALL --security-opt no-new-privileges \
        -e "JAIL_FLAKE=$JAIL_FLAKE" \
        -e "HOME_MANAGER_BACKUP_EXT=jail-bak" \
        "${mounts[@]}" "$IMAGE" \
        bash -eu -c '
            nix build --no-write-lock-file \
                --out-link ~/.jail-activation "$JAIL_FLAKE"
            ~/.jail-activation/activate
            # The agent CLIs are installed into the jail home rather
            # than the store, so provisioning is where they arrive and
            # where they are refreshed; between provisions they update
            # themselves, or the agent runs agent-update itself.
            . ~/.nix-profile/etc/profile.d/hm-session-vars.sh
            agent-update || echo "agent-jail: agent-update failed" >&2
        '
    printf '%s\n' "$env_hash" >"$HOST_ENV_HASH"
fi

# ============================================================
#                            Run
# ============================================================

# Tell the agent it's jailed — session-only, no file in the jail.
JAIL_NOTE="$(<"$SCRIPT_DIR/jail-prompt.md")"
# The project maps to a different path on the host; tell the agent the real one.
JAIL_NOTE+="

$CONTAINER_WORK is the host directory: $HOST_PROJECT — use that path when
reporting to the user or writing commands the user runs on the host."

if [ "$AGENT" = claude ]; then
    agent_command=(
        claude
        --dangerously-skip-permissions
        --append-system-prompt "$JAIL_NOTE"
    )
else
    agent_command=(
        codex
        --dangerously-bypass-approvals-and-sandbox
        -c "developer_instructions=$JAIL_NOTE"
    )
fi

# Agents are exec'd directly rather than through a login shell, so the
# wrapper sources what home-manager generated for the jail leaf first.
# Non-root, dropped caps, no priv-escalation, no host access beyond
# mounts; egress open. CLAUDE_CONFIG_DIR pins .claude.json inside the
# mounted home, else it's lost each --rm run.
docker run -it --rm \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --pids-limit 512 \
    -w "$CONTAINER_WORK" \
    -e "CLAUDE_CONFIG_DIR=$CONTAINER_CLAUDE_HOME" \
    -e "TERM=${TERM:-xterm-256color}" \
    -e "COLORTERM=${COLORTERM:-truecolor}" \
    -e "CLAUDE_CODE_NO_FLICKER=1" \
    "${mounts[@]}" \
    "$IMAGE" \
    bash -c '. ~/.nix-profile/etc/profile.d/hm-session-vars.sh; exec "$@"' \
    agent-jail "${agent_command[@]}" "$@"
