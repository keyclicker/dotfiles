#!/bin/sh
# dots — manage the ~/.dotfiles machine: status, rebuild, upgrade.
#
# Each cmd_* body below doubles as documentation: the commands run
# exactly as you would type them by hand.
set -eu

repo="$HOME/.dotfiles"
flake="$repo/.nix"
config="${XDG_CONFIG_HOME:-$HOME/.config}/dots/config.json"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/dots.json"

check_ttl_hours=6    # `warn` refreshes the cache when older than this
nixpkgs_warn_days=14 # `warn` nags when the nixpkgs pin is older than this

usage() {
  cat <<EOF
dots — dotfiles machine manager

usage: dots <command> [args]

  status                 host, repo drift, nixpkgs pin age (fetches origin)
  list                   flake targets; * marks this machine's
  rebuild [host] [args]  build + switch this machine (darwin/nixos/home auto)
  upgrade [host] [args]  pull repo, bump flake.lock, rebuild
  set [host]             pin default host for rebuilds; bare \`set\` shows it
  unset                  back to hostname autodetect
  help                   this text

plumbing:
  warn                   one-line drift warning; zshrc runs it at login and
                         it refreshes the status cache in background if stale

host resolution: explicit arg > \`dots set\` pin > autodetect
(mac on darwin, short hostname elsewhere).
EOF
}

# ==========================================================
#                  Helpers (the only three)
# ==========================================================

# darwin | nixos | home (Ubuntu and friends: user environment only)
detect_mode() {
  case "$(uname -s)" in
    Darwin) echo darwin ;;
    Linux) if [ -e /etc/NIXOS ]; then echo nixos; else echo home; fi ;;
    *) echo "dots: unsupported OS: $(uname -s)" >&2; exit 1 ;;
  esac
}

pinned_host() {
  if [ -f "$config" ]; then jq -r '.host // empty' "$config"; fi
}

resolve_host() {
  host="$(pinned_host)"
  if [ -n "$host" ]; then
    echo "$host"
  elif [ "$(detect_mode)" = darwin ]; then
    echo mac
  else
    hostname -s
  fi
}

# ==========================================================
#                          Commands
# ==========================================================

# Where this machine stands: fetch origin, recompute drift,
# cache the result for `warn`.
cmd_status() {
  git -C "$repo" fetch origin --prune --quiet
  behind="$(git -C "$repo" rev-list --count HEAD..origin/master)"
  ahead="$(git -C "$repo" rev-list --count origin/master..HEAD)"
  locked="$(jq -r '.nodes.nixpkgs.locked.lastModified' "$flake/flake.lock")"
  mkdir -p "$(dirname "$cache")"
  jq -n --argjson checked_at "$(date +%s)" \
        --argjson repo_behind "$behind" --argjson repo_ahead "$ahead" \
        --argjson nixpkgs_locked "$locked" \
        '$ARGS.named' > "$cache"

  if [ -n "$(pinned_host)" ]; then src=pinned; else src=autodetect; fi
  echo "host:    $(resolve_host) ($(detect_mode), $src)"
  if [ -e /run/current-system ]; then
    echo "system:  $(basename "$(readlink /run/current-system)" | sed 's/^[a-z0-9]*-//')"
  fi
  echo "repo:    $behind behind, $ahead ahead of origin/master"
  echo "nixpkgs: pinned $(( ($(date +%s) - locked) / 86400 ))d ago"
}

# Every buildable target in the flake.
cmd_list() {
  current="$(resolve_host)"
  for kind in nixosConfigurations darwinConfigurations homeConfigurations; do
    echo "$kind:"
    nix eval --json "$flake#$kind" --apply builtins.attrNames 2>/dev/null \
      | jq -r '.[]' | while read -r name; do
        if [ "$name" = "$current" ] || [ "$name" = "$USER@$current" ]; then
          printf '  * %s\n' "$name"
        else
          printf '    %s\n' "$name"
        fi
      done
  done
}

# One-liner for shell login; reads the cache, never blocks on network.
cmd_warn() {
  now="$(date +%s)"
  age="$((check_ttl_hours * 3600 + 1))"
  if [ -f "$cache" ]; then
    age="$((now - $(jq -r '.checked_at' "$cache")))"
    behind="$(jq -r '.repo_behind' "$cache")"
    nix_days="$(( (now - $(jq -r '.nixpkgs_locked' "$cache")) / 86400 ))"
    if [ "$behind" -gt 0 ]; then
      echo "dots: repo $behind commit(s) behind — run: dots upgrade"
    elif [ "$nix_days" -ge "$nixpkgs_warn_days" ]; then
      echo "dots: nixpkgs pin ${nix_days}d old — run: dots upgrade"
    fi
  fi
  if [ "$age" -gt "$((check_ttl_hours * 3600))" ]; then
    (cmd_status >/dev/null 2>&1 &) # next shell sees a fresh cache
  fi
}

# Build the flake target and switch this machine onto it.
cmd_rebuild() {
  host="$(resolve_host)"
  if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then host="$1"; shift; fi
  case "$(detect_mode)" in
    darwin) sudo darwin-rebuild switch --flake "$flake#$host" "$@" ;;
    nixos)  sudo nixos-rebuild switch --flake "$flake#$host" "$@" ;;
    home)
      # -b: back up files home-manager wants to replace on first switch.
      if command -v home-manager >/dev/null 2>&1; then
        home-manager switch -b hm-bak --flake "$flake#$USER@$host" "$@"
      else # fresh host: home-manager exists only after first activation
        nix run home-manager -- switch -b hm-bak --flake "$flake#$USER@$host" "$@"
      fi ;;
  esac
}

# Take everything new: merged commits + fresh inputs, then switch.
cmd_upgrade() {
  git -C "$repo" pull --ff-only
  nix flake update --flake "$flake"
  cmd_rebuild "$@"
}

# Pin the flake host used by rebuild/upgrade.
cmd_set() {
  if [ "$#" -eq 0 ]; then
    host="$(pinned_host)"
    if [ -n "$host" ]; then echo "$host"; else echo "not pinned (autodetect)"; fi
    return
  fi
  if ! cmd_list | sed 's/^[ *]*//' | grep -qx -e "$1" -e "$USER@$1"; then
    echo "dots: no flake target '$1' (see: dots list)" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$config")"
  jq -n --arg host "$1" '{host: $host}' > "$config"
}

# Back to hostname autodetect.
cmd_unset() {
  rm -f "$config"
}

# ==========================================================
#                          Dispatch
# ==========================================================

cmd="${1:-help}"
if [ "$#" -gt 0 ]; then shift; fi
case "$cmd" in
  help|-h|--help) usage ;;
  status|list|warn|rebuild|upgrade|set|unset)
    "cmd_$cmd" "$@" ;;
  *) usage >&2; exit 1 ;;
esac
