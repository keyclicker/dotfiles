#!/bin/sh
# Rebuild this machine from the ~/.dotfiles/.nix flake.
#
# Usage: nix-rebuild [host] [extra rebuild args...]
#   host defaults to "mac" on darwin, short hostname on NixOS.
set -eu

flake="$HOME/.dotfiles/.nix"

case "$(uname -s)" in
  Darwin) mode=darwin; default_host=mac ;;
  Linux)
    # NixOS rebuilds the system; other distros (Ubuntu pi) only get a
    # home-manager user environment.
    if [ -e /etc/NIXOS ]; then mode=nixos; else mode=home; fi
    default_host="$(hostname -s)"
    ;;
  *) echo "nix-rebuild: unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac

# First arg is a host name unless it looks like a flag.
host="$default_host"
if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
  host="$1"
  shift
fi

case "$mode" in
  darwin) sudo darwin-rebuild switch --flake "$flake#$host" "$@" ;;
  nixos)  sudo nixos-rebuild switch --flake "$flake#$host" "$@" ;;
  home)
    # -b: standalone home-manager has no backupFileExtension option in
    # the flake (unlike the darwin/NixOS blocks), so back up clashing
    # files on first switch instead of failing; no-op afterwards.
    # First switch on a fresh host: home-manager isn't installed yet
    # (programs.home-manager.enable only applies after activation).
    if command -v home-manager >/dev/null 2>&1; then
      home-manager switch -b hm-bak --flake "$flake#$USER@$host" "$@"
    else
      nix run home-manager -- switch -b hm-bak \
        --flake "$flake#$USER@$host" "$@"
    fi
    ;;
esac

# The agent CLIs live in $HOME, not the store (see
# .nix/modules/agents.nix), so the switch alone does not move them.
# agent-update comes from that module: hosts without agent CLIs (vps)
# have no such command and skip this. A failure here is not a failed
# rebuild, hence the `||` shielding it from set -e.
if command -v agent-update >/dev/null 2>&1; then
  agent-update ||
    echo "nix-rebuild: agent-update failed; CLIs left as they were" >&2
fi
