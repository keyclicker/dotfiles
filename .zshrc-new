
# =========================================================
#                    Robby Russell theme
# =========================================================

autoload -U colors && colors   # $fg / $fg_bold / $reset_color
setopt PROMPT_SUBST            # re-eval $(...) every prompt

# omz-free git_prompt_info
git_prompt_info() {
  local ref
  ref=$(GIT_OPTIONAL_LOCKS=0 git symbolic-ref --short HEAD 2>/dev/null) \
    || ref=$(GIT_OPTIONAL_LOCKS=0 git rev-parse --short HEAD 2>/dev/null) \
    || return 0
  local dirty=$ZSH_THEME_GIT_PROMPT_CLEAN
  [[ -n $(GIT_OPTIONAL_LOCKS=0 git status --porcelain --ignore-submodules=dirty 2>/dev/null) ]] \
    && dirty=$ZSH_THEME_GIT_PROMPT_DIRTY
  echo "${ZSH_THEME_GIT_PROMPT_PREFIX}${ref}${dirty}${ZSH_THEME_GIT_PROMPT_SUFFIX}"
}

PROMPT="%(?:%{$fg_bold[green]%}%1{➜%} :%{$fg_bold[red]%}%1{➜%} ) %{$fg[cyan]%}%c%{$reset_color%}"
PROMPT+=' $(git_prompt_info)'

ZSH_THEME_GIT_PROMPT_PREFIX="%{$fg_bold[blue]%}git:(%{$fg[red]%}"
ZSH_THEME_GIT_PROMPT_SUFFIX="%{$reset_color%} "
ZSH_THEME_GIT_PROMPT_DIRTY="%{$fg[blue]%}) %{$fg[yellow]%}%1{✗%}"
ZSH_THEME_GIT_PROMPT_CLEAN="%{$fg[blue]%})"

plugins=(
  git
  docker
  docker-compose
  # zsh-vi-mode
  fancy-ctrl-z
  poetry
)



CASE_SENSITIVE="false"
HYPHEN_INSENSITIVE="true"

source $ZSH/oh-my-zsh.sh

# Locale
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Preferred editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='mvim'
fi


# =========================================================
#                        Aliases
# =========================================================

alias cl="clear; clear"

alias ql="qlmanage -p"
alias yt="yt-dlp"

alias ff="ffmpeg -hide_banner -i"
alias ffp="ffprobe -hide_banner"

alias em="emacsclient -c -a \"emacs\""
alias vi="nvim"
alias v="nvim ."

alias vp="nvim -c \"lua require('persistence').load()\""
alias vg="nvim -c \"Neogit\""

alias vdot="cd ~/.dotfiles; nvim ."
alias vzsh="cd ~/.dotfiles; nvim .zshrc"
alias vcfg="cd ~/.dotfiles/.config/nvim; nvim ."
alias zsrc='source ~/.dotfiles/.zshrc'

alias gw="git worktree"
alias gs="git status"

git-pwd() {
  local common_dir
  if common_dir=$(git rev-parse --git-common-dir 2>/dev/null); then
    dirname "$(cd "$common_dir" && pwd)"
  else
    pwd
  fi
}

cll() {
  local root
  root=$(git-pwd)
  claude --settings "{\"autoMemoryDirectory\":\"$root/.claude/memory\"}" "$@"
}

# =========================================================
#               Environment Variables
# =========================================================

export PATH="$HOME/.scripts:$PATH"
export PATH="/opt/homebrew/opt/postgresql@18/bin:$PATH"
export PATH="$HOME/.emacs.d/bin:$PATH"
export PATH="$HOME/.config/emacs/bin:$PATH"

export GPG_TTY=$(tty)
export CLAUDE_CODE_NO_FLICKER=1

export HISTORY_IGNORE="(ls|ll|la|l|pwd|cd|fg|jobs|history|exit|clear|vp|v|vi|vim|nvim|fzf)"

export XDG_DATA_DIRS="/opt/homebrew/share"

# =========================================================
#                 Init utilities
# =========================================================

# Fzf
source <(fzf --zsh)

# Created by `pipx` on 2024-04-30 11:04:43
export PATH="$PATH:/Users/keyclicker/.local/bin"

export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

# Lazy nvm
lazy_load_nvm() {
  unset -f nvm node npm npx
  export NVM_DIR="$HOME/.nvm"
  [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
  [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
}
nvm() {
  lazy_load_nvm
  nvm "$@"
}
node() {
  lazy_load_nvm
  node "$@"
}
npm() {
  lazy_load_nvm
  npm "$@"
}
npx() {
  lazy_load_nvm
  npx "$@"
}

# =========================================================
#                  Plugins (submodules)
# =========================================================
# Repo dir from this file's real path (follows symlinks)
ZSH_PLUGIN_DIR=${${(%):-%x}:A:h}/submodules

source $ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh

# syntax-highlighting must source last (after compinit + all zle -N widgets)
source $ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# history-substring-search must source after syntax-highlighting
source $ZSH_PLUGIN_DIR/zsh-history-substring-search/zsh-history-substring-search.zsh
bindkey "$terminfo[kcuu1]" history-substring-search-up    # up arrow
bindkey "$terminfo[kcud1]" history-substring-search-down  # down arrow
bindkey -M vicmd 'k' history-substring-search-up
bindkey -M vicmd 'j' history-substring-search-down

